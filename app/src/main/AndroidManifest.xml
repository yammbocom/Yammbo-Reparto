<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- La ubicacion NO es opcional en esta app: es la senal de que hay alguien
         disponible. Sin ella el servidor no ofrece pedidos y la pantalla se
         planta. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 🚨 Tipo `location` y NO `dataSync`: con este tipo, un servicio en primer
         plano arrancado con la app visible puede seguir leyendo el GPS con la
         pantalla apagada SIN pedir ACCESS_BACKGROUND_LOCATION. Con `dataSync`
         Android 15 lo cortaria a las 6 h y el GPS se apagaria solo a mitad de
         turno. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- El cartel se dibuja ENCIMA de lo que haya delante (el mapa, WhatsApp,
         la pantalla de inicio). Es el permiso que ninguna web puede tener, y
         la razon de que esto sea una app y no una pestana. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Un movil sin GPS no puede repartir, pero no se marca `required` para no
         excluir tablets con solo red; el codigo ya exige una posicion real. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Sin arranque automatico a proposito. Ponerse a compartir la ubicacion
         sola tras reiniciar el movil no es "estar de turno": entrar al turno
         tiene que ser un acto deliberado. Ademas Android 14 no deja arrancar un
         servicio de tipo location desde BOOT_COMPLETED, asi que hacerlo
         fallaria en silencio y la app pareceria disponible sin estarlo. -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Tema.Yammbo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AjustesActivity"
            android:exported="false"
            android:label="@string/ajustes" />

        <service
            android:name=".ServicioReparto"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>
</manifest>
