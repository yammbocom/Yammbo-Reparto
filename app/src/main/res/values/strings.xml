    <!-- Lo que leen tambien los revisores de la declaracion de ubicacion de Play. -->
    <string name="puerta_ubicacion_titulo">Share your location during your shift</string>
    <string name="puerta_ubicacion_permiso">Yammbo Delivery uses your location to show you as
        available and to assign you nearby orders. It is shared only while your shift is on,
        also with the screen off. Customers see your position only while you carry their
        order. You can end your shift at any time.</string>
    <string name="puerta_ubicacion_notis">You will also be asked to allow notifications, so new
        orders reach you.</string>
    <string name="puerta_ubicacion_apagada">The permission is granted, but your phone\'s location
        is switched off. Turn it on to be available again.</string>
    <string name="puerta_ubicacion_boton">Allow location</string>
    <string name="puerta_ubicacion_ajustes">Open location settings</string>

    <string name="puerta_cartel_titulo">Show orders over other apps</string>
    <string name="puerta_cartel_texto">A new order has to reach you while you look at the map or
        another app. Without this you only get a notification, and it is easy to miss.</string>
    <string name="puerta_cartel_pista">In the list, find Yammbo Delivery and turn it on.</string>
    <string name="puerta_cartel_boton">Allow display over apps</string>

