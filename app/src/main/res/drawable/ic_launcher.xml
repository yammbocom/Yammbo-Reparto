<?xml version="1.0" encoding="utf-8"?>
<!-- Una bolsa de reparto con su asa. B/N estricto, como el resto de Yammbo.
     NO es el icono de la app de cocina: las dos se instalan en el mismo movil y
     dos recibos identicos en el cajon de aplicaciones no se distinguen. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <path android:fillColor="#000000" android:pathData="M0,0h108v108h-108z" />

    <!-- El asa, un arco hueco por encima del cuerpo. -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M39,41 A15,15 0 0 1 69,41 H63 A9,9 0 0 0 45,41 Z" />

    <!-- El cuerpo de la bolsa, mas ancho abajo que arriba. -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M28,41 H80 A6,6 0 0 1 86,47 V82 A6,6 0 0 1 80,88 H28 A6,6 0 0 1 22,82 V47 A6,6 0 0 1 28,41 Z" />

    <!-- La cinta horizontal: es lo que la separa de una caja cualquiera. -->
    <path android:fillColor="#000000" android:pathData="M22,58 H86 V65 H22 Z" />
    <!-- El cierre, centrado sobre la cinta. -->
    <path android:fillColor="#000000" android:pathData="M48,50 h12 v23 h-12 z" />
</vector>
