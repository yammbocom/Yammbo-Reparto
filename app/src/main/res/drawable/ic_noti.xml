<?xml version="1.0" encoding="utf-8"?>
<!-- Icono de la barra de estado.
     Android lo pinta como SILUETA: el color se ignora y cuenta solo el alfa,
     asi que un trazo "negro" encima no seria un hueco sino mas mancha. El
     interior se vacia de verdad con fillType="evenOdd". -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">

    <!-- Asa: arco hueco. -->
    <path android:fillColor="#FFFFFF" android:fillType="evenOdd"
        android:pathData="M8.3,7 A3.7,3.7 0 0 1 15.7,7 H14 A2,2 0 0 0 10,7 Z" />

    <!-- Cuerpo con el interior vaciado. -->
    <path android:fillColor="#FFFFFF" android:fillType="evenOdd"
        android:pathData="M4,7 H20 A1.5,1.5 0 0 1 21.5,8.5 V20 A1.5,1.5 0 0 1 20,21.5 H4 A1.5,1.5 0 0 1 2.5,20 V8.5 A1.5,1.5 0 0 1 4,7 Z M4.3,9 H19.7 V19.7 H4.3 Z" />

    <!-- La cinta, dentro del hueco. -->
    <path android:fillColor="#FFFFFF" android:pathData="M4.3,12.4 H19.7 V14.2 H4.3 Z" />
</vector>
